[Unit]
Description=IoT Group Project Modes System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=modes
Group=modes
WorkingDirectory=/opt/modes
ExecStart=/usr/bin/python3 /opt/modes/modes/entry.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=modes-system

[Install]
WantedBy=multi-user.target
